# Gnani API key from https://app.gnani.ai/voice
GNANI_API_KEY=

# Dadi's brain: any OpenAI-compatible chat completions API
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_REASONING_EFFORT=low

# The database (accounts, calls, progress, boards). Defaults to DATA_DIR/hangup.db.
# With S3_BUCKET set, it is also restored from and backed up to the bucket, for hosts
# that wipe their disk on deploy. Run one instance only.
DATABASE_PATH=

# Storage for the public counters. Defaults to ./data; on hosts that wipe files
# on restart, use an S3-compatible bucket.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
